{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_excel_modeler_md", "label": "pl-excel-modeler.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-excel-modeler.md", "source_location": "L1", "frontmatter": {"name": "pl-excel-modeler", "description": "\u0421\u043e\u0431\u0438\u0440\u0430\u0435\u0442 \u0436\u0438\u0432\u044b\u0435 Excel-\u0444\u0430\u0439\u043b\u044b (.xlsx) \u0441 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438 \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau (\u0441\u043e\u043b\u043e-\u0432\u0435\u0431-\u0441\u0442\u0443\u0434\u0438\u044f Pavel Levdin) \u0447\u0435\u0440\u0435\u0437 Python/openpyxl \u2014 \u0444\u0438\u043d\u043c\u043e\u0434\u0435\u043b\u044c \u0441\u0442\u0443\u0434\u0438\u0438 \u043f\u043e \u043b\u043e\u0433\u0438\u043a\u0435 pl-financial-modeler (\u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u044f \u2192 \u0432\u044b\u0440\u0443\u0447\u043a\u0430 \u043f\u043e \u043f\u0430\u043a\u0435\u0442\u0430\u043c \u0438 \u0440\u0435\u0442\u0435\u0439\u043d\u0435\u0440\u0430\u043c \u2192 \u0440\u0430\u0441\u0445\u043e\u0434\u044b \u2192 P&amp;L \u2192 cash flow \u2192 break-even \u2192 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c), \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440 \u041a\u041f/Angebot \u043f\u043e \u043f\u0430\u043a\u0435\u0442\u0430\u043c \u0438\u0437 pricing.json, \u0442\u0440\u0435\u043a\u0435\u0440\u044b (\u043b\u0438\u0434\u044b \u043f\u043e \u043a\u0430\u043d\u0430\u043b\u0430\u043c, outreach \u043f\u0430\u0440\u0442\u043d\u0451\u0440\u043e\u0432, \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0438), \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0434\u043b\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u0441\u043a\u0438\u0445 SEO-\u043e\u0442\u0447\u0451\u0442\u043e\u0432. RU (\u20bd) \u0438 DE (\u20ac). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0434\u043b\u044f \u00ab\u0441\u0434\u0435\u043b\u0430\u0439 Excel\u00bb, \u00abxlsx \u0441 \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u043c\u0438\u00bb,", "tools": "Read, Write, Edit, Bash, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_excel_modeler_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-excel-modeler.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_excel_modeler_\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442", "label": "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-excel-modeler.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_excel_modeler_\u0447\u0442\u043e_\u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0448\u044c_business", "label": "\u0427\u0442\u043e \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0448\u044c (`_business/\u2026`)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-excel-modeler.md", "source_location": "L14"}, {"id": "$graphify-root$_claude_retired_agents_pl_excel_modeler_\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435_\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f", "label": "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-excel-modeler.md", "source_location": "L21"}, {"id": "$graphify-root$_claude_retired_agents_pl_excel_modeler_\u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "label": "\u041c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_re