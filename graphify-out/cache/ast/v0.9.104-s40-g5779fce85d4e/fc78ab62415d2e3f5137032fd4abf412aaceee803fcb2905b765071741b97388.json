{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_document_formatter_md", "label": "pl-document-formatter.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-document-formatter.md", "source_location": "L1", "frontmatter": {"name": "pl-document-formatter", "description": "\u0421\u043e\u0431\u0438\u0440\u0430\u0435\u0442 \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 PDF \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau \u2014 \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 (\u041a\u041f / Angebot), \u0431\u0440\u0438\u0444-\u0440\u0435\u0437\u044e\u043c\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0430, \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435, \u043e\u0442\u0447\u0451\u0442 SEO-\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u0431\u0438\u0437\u043d\u0435\u0441-\u043f\u043b\u0430\u043d \u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u043d\u044b\u0435 Entw\u00fcrfe. RU \u0438 DE. Typst \u0438\u043b\u0438 pandoc + XeLaTeX, fallback HTML \u2192 headless Chrome. \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u043a\u0430 \u0432 \u0441\u0442\u0438\u043b\u0435 PL, \u043e\u0431\u043b\u043e\u0436\u043a\u0430, \u043e\u0433\u043b\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u043d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u044f, \u0432\u0441\u0442\u0430\u0432\u043a\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u043e\u0432. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0434\u043b\u044f \u00ab\u0441\u0434\u0435\u043b\u0430\u0439 PDF\u00bb, \u00ab\u043e\u0444\u043e\u0440\u043c\u0438 \u041a\u041f\u00bb, \u00ab\u0441\u043e\u0431\u0435\u0440\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u00bb. \u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u2014 \u043f\u043e\u0441\u043b\u0435 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u043d\u044b\u0445 \u0430\u0433\u0435\u043d\u0442\u043e\u0432.", "tools": "Read, Write, Edit, Bash, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_document_formatter_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-document-formatter.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_document_formatter_\u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442", "label": "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-document-formatter.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_document_formatter_\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b_business_output", "label": "\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b (`_business/output/`)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-document-formatter.md", "source_location": "L20"}, {"id": "$graphify-root$_claude_retired_agents_pl_document_formatter_\u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u043a\u0430", "label": "\u0422\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u043a\u0430", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-document-formatter.md", "source_location": "L27"}, {"id": "$graphify-root$_claude_retired_agents_pl_document_formatter_\u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "label": "\u041c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "file_type": "document", "node_kind": "heading", "sourc