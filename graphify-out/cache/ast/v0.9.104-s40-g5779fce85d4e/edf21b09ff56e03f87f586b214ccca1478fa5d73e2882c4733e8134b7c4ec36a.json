{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_financial_modeler_md", "label": "pl-financial-modeler.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-financial-modeler.md", "source_location": "L1", "frontmatter": {"name": "pl-financial-modeler", "description": "\u0424\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0439 \u043c\u043e\u0434\u0435\u043b\u0438\u0441\u0442 PL \u2013 Innovativ Digitalbau (\u0441\u043e\u043b\u043e-\u0432\u0435\u0431-\u0441\u0442\u0443\u0434\u0438\u044f Pavel Levdin). \u0421\u0442\u0440\u043e\u0438\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c \u0444\u0440\u0438\u043b\u0430\u043d\u0441\u0435\u0440\u0430/\u0441\u0442\u0443\u0434\u0438\u0438 \u2014 \u0432\u044b\u0440\u0443\u0447\u043a\u0430 \u043f\u043e \u043f\u0430\u043a\u0435\u0442\u0430\u043c \u0438 \u0440\u0435\u0442\u0435\u0439\u043d\u0435\u0440\u0430\u043c \u0438\u0437 pricing.json, \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0438 \u0447\u0430\u0441\u044b, \u0440\u0430\u0441\u0445\u043e\u0434\u044b (\u041f\u041e, \u0445\u043e\u0441\u0442\u0438\u043d\u0433, AI, \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0438, \u043d\u0430\u043b\u043e\u0433\u0438/\u0432\u0437\u043d\u043e\u0441\u044b), P&amp;L \u043f\u043e\u043c\u0435\u0441\u044f\u0447\u043d\u043e, cash flow \u0441 \u044d\u0442\u0430\u043f\u0430\u043c\u0438 \u043e\u043f\u043b\u0430\u0442\u044b, break-even, \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0438 \u0438 \u0441\u0442\u0440\u0435\u0441\u0441-\u0442\u0435\u0441\u0442\u044b (Markdown + CSV); \u0436\u0438\u0432\u043e\u0439 .xlsx \u043f\u043e \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 pl-excel-modeler. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0434\u043b\u044f \u00ab\u0444\u0438\u043d\u043c\u043e\u0434\u0435\u043b\u044c\u00bb, \u00abP&amp;L\u00bb, \u00abcash flow\u00bb, \u00ab\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0443\u0436\u043d\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432\u00bb, \u00abbreak-even\u00bb.", "tools": "Read, Write, Edit, Bash, WebSearch, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_financial_modeler_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-financial-modeler.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_financial_modeler_\u0432\u0445\u043e\u0434\u043d\u044b\u0435_\u0434\u0430\u043d\u043d\u044b\u0435", "label": "\u0412\u0445\u043e\u0434\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-financial-modeler.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_financial_modeler_\u0441\u043e\u0441\u0442\u0430\u0432_\u043c\u043e\u0434\u0435\u043b\u0438", "label": "\u0421\u043e\u0441\u0442\u0430\u0432 \u043c\u043e\u0434\u0435\u043b\u0438", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-financial-modeler.md", "source_location": "L16"}, {"id": "$graphify-root$_claude_retired_agents_pl_financial_modeler_excel", "label": "Excel", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-financial-modeler.md", "source_location": "L26"}, {"id": "$graphify-root$_claude_retired_agents_pl_financial_modeler_\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u044b", "label": "\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u044b", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-financial-modeler.md", "source_location": "L29"}, {"id": "$graphify-root$_claude_retired_agents_pl_financial_modeler_\u0444\u043e\u0440\u043c\u0430\u0442_\u043e\u0442\u0432\u0435\u0442\u0430", "label": "\u0424\u043e\u0440\u043c\u0430\u0442 