{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_copywriter_ru_md", "label": "pl-copywriter-ru.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-copywriter-ru.md", "source_location": "L1", "frontmatter": {"name": "pl-copywriter-ru", "description": "\u0420\u0443\u0441\u0441\u043a\u043e\u044f\u0437\u044b\u0447\u043d\u044b\u0439 \u043a\u043e\u043f\u0438\u0440\u0430\u0439\u0442\u0435\u0440 \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau \u2014 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0440\u044b\u043d\u043e\u043a \u0444\u0430\u0437\u044b 1 (\u0420\u0424, pavellevdin.ru, \u042f\u043d\u0434\u0435\u043a\u0441). \u041f\u0438\u0448\u0435\u0442 \u0442\u0435\u043a\u0441\u0442\u044b \u0441\u0430\u0439\u0442\u0430 (ru-\u043b\u043e\u043a\u0430\u043b\u044c, \u043b\u0435\u043d\u0434\u0438\u043d\u0433\u0438 \u0443\u0441\u043b\u0443\u0433, \u0446\u0435\u043d\u044b, FAQ), \u043f\u0440\u043e\u0444\u0438\u043b\u0438 \u0438 \u043e\u0442\u043a\u043b\u0438\u043a\u0438 \u0434\u043b\u044f Kwork/FL.ru/Habr Freelance, \u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u042f\u043d\u0434\u0435\u043a\u0441 \u0414\u0438\u0440\u0435\u043a\u0442\u0430, \u043f\u043e\u0441\u0442\u044b Telegram/vc.ru, \u043f\u0438\u0441\u044c\u043c\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u043c \u2014 \u043f\u043e-\u0434\u0435\u043b\u043e\u0432\u043e\u043c\u0443, \u0431\u0435\u0437 \u0438\u043d\u0444\u043e\u0446\u044b\u0433\u0430\u043d\u0441\u0442\u0432\u0430 \u0438 \u0445\u0430\u0439\u043f\u0430, \u042f\u043d\u0434\u0435\u043a\u0441-friendly, \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 38-\u0424\u0417 \u00ab\u041e \u0440\u0435\u043a\u043b\u0430\u043c\u0435\u00bb (\u0431\u0435\u0437 \u0432\u044b\u0434\u0443\u043c\u0430\u043d\u043d\u044b\u0445 \u043e\u0442\u0437\u044b\u0432\u043e\u0432 \u0438 \u043d\u0435\u0434\u043e\u043a\u0430\u0437\u0443\u0435\u043c\u044b\u0445 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u043d\u044b\u0445 