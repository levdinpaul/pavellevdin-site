{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_orchestrator_md", "label": "pl-orchestrator.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-orchestrator.md", "source_location": "L1", "frontmatter": {"name": "pl-orchestrator", "description": "\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0434\u0438\u0440\u0438\u0436\u0451\u0440 \u0431\u0438\u0437\u043d\u0435\u0441-\u0441\u0438\u0441\u0442\u0435\u043c\u044b PL \u2013 Innovativ Digitalbau (\u0441\u043e\u043b\u043e-\u0432\u0435\u0431-\u0441\u0442\u0443\u0434\u0438\u044f Pavel Levdin, Hannover; \u0440\u044b\u043d\u043a\u0438 RU \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 DE/\u0415\u0421 \u043f\u043e\u0442\u043e\u043c). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u043c\u043d\u043e\u0433\u043e\u0448\u0430\u0433\u043e\u0432\u043e\u0439 \u0431\u0438\u0437\u043d\u0435\u0441-\u0437\u0430\u0434\u0430\u0447\u0438 \u043f\u043e \u0441\u0430\u0439\u0442\u0443-\u043f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e \u0438\u043b\u0438 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435 pl-platform \u2014 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430, \u0446\u0435\u043d\u044b, \u0440\u044b\u043d\u043e\u043a, \u043b\u0438\u0434\u044b, \u0442\u0435\u043a\u0441\u0442\u044b, \u044e\u0440/\u043d\u0430\u043b\u043e\u0433\u0438, \u043f\u0430\u0440\u0442\u043d\u0451\u0440\u044b, \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b. \u0414\u0435\u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0440\u0443\u0435\u0442 \u0446\u0435\u043b\u044c, \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043f\u043e \u0441\u0432\u043e\u0438\u043c pl-* \u0430\u0433\u0435\u043d\u0442\u0430\u043c \u0438 \u043f\u043e \u043e\u0431\u0449\u0438\u043c \u0430\u0433\u0435\u043d\u0442\u0430\u043c \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e, \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0438 \u0421\u0422\u041e\u041f \u043d\u0430 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 Pavel. \u0421\u0430\u043c\u043e\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u0435\u043d, \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0433\u043e orchestrator.", "tools": "Read, Write, Edit, Bash, WebSearch, WebFetch, Glob, Grep, Agent", "model": "opus"}}, {"id": "$graphify-root$_claude_retired_agents_pl_orchestrator_\u043f\u0440\u0438\u043d\u0446\u0438\u043f_\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u0438_\u0431\u0435\u0437_\u043b\u0438\u0448\u043d\u0438\u0445_\u0446\u0435\u043f\u043e\u0447\u0435\u043a", "label": "\u041f\u0440\u0438\u043d\u0446\u0438\u043f \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u0438 (\u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0438\u0445 \u0446\u0435\u043f\u043e\u0447\u0435\u043a)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-orchestrator.md", "source_location": "L9"}, {"id": "$graphify-root$_claude_retired_agents_pl_orchestrator_\u043f\u0440\u043e\u0435\u043a\u0442\u043d\u044b\u0439_\u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442_\u043a\u0430\u043d\u043e\u043d\u044b_\u043d\u0435_\u0432\u044b\u0434\u0443\u043c\u044b\u0432\u0430\u0442\u044c_\u0441\u0432\u0435\u0440\u0445_\u043d\u0438\u0445", "label": "\u041f\u0440\u043e\u0435\u043a\u0442\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 (\u043a\u0430\u043d\u043e\u043d\u044b \u2014 \u043d\u0435 \u0432\u044b\u0434\u0443\u043c\u044b\u0432\u0430\u0442\u044c \u0441\u0432\u0435\u0440\u0445 \u043d\u0438\u0445)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-orchestrator.md", "source_location": "L16"}, {"id": "$graphify-root$_claude_retired_agents_pl_orchestrator_\u0