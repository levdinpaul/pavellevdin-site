{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_digital_foerderung_md", "label": "pl-digital-foerderung.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-digital-foerderung.md", "source_location": "L1", "frontmatter": {"name": "pl-digital-foerderung", "description": "\u042d\u043a\u0441\u043f\u0435\u0440\u0442 \u043f\u043e \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u044f\u043c \u043d\u0430 \u0446\u0438\u0444\u0440\u043e\u0432\u0438\u0437\u0430\u0446\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043c\u043e\u0433\u0443\u0442 \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u041a\u041b\u0418\u0415\u041d\u0422\u042b PL \u2013 Innovativ Digitalbau (\u0441\u0430\u0439\u0442, \u0432\u0435\u0431-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438, AI-\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u043a\u0430\u043a \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0440\u0443\u0435\u043c\u044b\u0439 \u043f\u0440\u043e\u0435\u043a\u0442). DE \u2014 \u0444\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u0438 \u0437\u0435\u043c\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0434\u043b\u044f KMU (\u043d\u0430\u043f\u0440. Digitalbonus.Niedersachsen / NBank, KfW-\u043a\u0440\u0435\u0434\u0438\u0442\u044b \u043d\u0430 \u0446\u0438\u0444\u0440\u043e\u0432\u0438\u0437\u0430\u0446\u0438\u044e, Mittelstand-Digital Zentren, \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0439; \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0440\u0430\u043d\u0435\u0435 go-digital \u0438 Digital Jetzt \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438, \u043e\u0442\u043a\u0440\u044b\u0442 \u043b\u0438 \u043f\u0440\u0438\u0451\u043c) \u2014 \u0441 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u043e\u0439 \u0442\u0435\u043a\u0443\u0449\u0435\u0433\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0430. \u0420\u0424 \u2014 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u041c\u0421\u041f (\u0446\u0435\u043d\u0442\u0440\u044b \u00ab", "tools": "Read, Write, Edit, WebSearch, WebFetch, Glob, Grep", "model": "opus"}}, {"id": "$graphify-root$_claude_retired_agents_pl_digital_foerderung_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-digital-foerderung.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_digital_foerderung_\u0434\u0438\u0441\u043a\u043b\u0435\u0439\u043c\u0435\u0440_\u0432_\u043a\u0430\u0436\u0434\u043e\u043c_\u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u0435", "label": "\u0414\u0418\u0421\u041a\u041b\u0415\u0419\u041c\u0415\u0420 (\u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u0435)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-digital-foerderung.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_digital_foerderung_\u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0435_\u043f\u0440\u0430\u0432\u0438\u043b\u043e_\u0441\u0442\u0430\u0442\u0443\u0441_\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b_\u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442\u0441\u044f_\u043a\u0430\u0436\u0434\u044b\u0439_\u0440\u0430\u0437", "label": "\u041a\u043b\u044e\u0447\u0435\u0432\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e: \u0441\u0442\u0430\u0442\u0443\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u041a\u0410\u0416\u0414\u042