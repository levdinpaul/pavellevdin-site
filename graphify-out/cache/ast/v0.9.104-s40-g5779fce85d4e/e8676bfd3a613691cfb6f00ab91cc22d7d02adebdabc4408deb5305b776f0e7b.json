{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_market_analyst_md", "label": "pl-market-analyst.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-market-analyst.md", "source_location": "L1", "frontmatter": {"name": "pl-market-analyst", "description": "\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u043a \u0440\u044b\u043d\u043a\u0430 \u0432\u0435\u0431-\u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau \u043d\u0430 \u0434\u0432\u0443\u0445 \u0440\u044b\u043d\u043a\u0430\u0445 \u2014 \u0420\u0424 (\u0444\u0430\u0437\u0430 1) \u0438 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f/Hannover/\u0415\u0421 (\u0444\u0430\u0437\u0430 2). \u0418\u0441\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0441\u043f\u0440\u043e\u0441 (\u0441\u0430\u0439\u0442\u044b, \u0432\u0435\u0431-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, SEO/AI-\u043f\u043e\u0438\u0441\u043a, \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438, AI-\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f), \u0446\u0435\u043d\u044b \u0444\u0440\u0438\u043b\u0430\u043d\u0441\u0435\u0440\u043e\u0432 vs \u0441\u0442\u0443\u0434\u0438\u0439 vs \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432, \u0441\u0442\u0430\u0432\u043a\u0438 \u20ac/h \u0438 \u20bd/\u0447, \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u0432 (\u0441\u0442\u0443\u0434\u0438\u0438, \u0444\u0440\u0438\u043b\u0430\u043d\u0441\u0435\u0440\u044b, \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440\u044b Tilda/Wix), \u043a\u0430\u043d\u0430\u043b\u044b \u043f\u0440\u0438\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f, \u0442\u0440\u0435\u043d\u0434\u044b (Next.js, headless CMS, AEO/GEO, MCP). \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0431\u0435\u043d\u0447\u043c\u0430\u0440\u043a\u0438 \u0434\u043b\u044f \u0446\u0435\u043d, \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u0444\u0438\u043d\u043c\u043e\u0434\u0435\u043b\u0438. \u041e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u0435\u0442 \u0431\u044b\u0432\u0448\u0438\u0435 market-analyst (\u0440\u044b\u043d\u043e\u043a \u0441\u0442\u0440\u0430\u043d\u044b) \u0438 market-de (\u0440\u0435", "tools": "Read, Write, WebSearch, WebFetch, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_market_analyst_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-market-analyst.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_market_analyst_\u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442", "label": "\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-market-analyst.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_market_analyst_\u0440\u044b\u043d\u043a\u0438_\u0438_\u0447\u0442\u043e_\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c", "label": "\u0420\u044b\u043d\u043a\u0438 \u0438 \u0447\u0442\u043e \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-market-analyst.md", "source_location": "L15"}, {"id": "$graphify-root$_claude_retired_agents_pl_market_analyst_\u0440\u0444_\u0444\u0430\u0437\u0430_1", "label": "\u0420\u0424 (\u0444\u0430\u0437\u0430 1)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-market-analyst.md", "source_location": "L16"}, {"id": "$graphify-root$_claude_retired_agents_pl_market_analyst_\u0433\u0435\u0440\u043c\u0430\u043d\u0438\u044f_\u0435\u0441_\u0444\u0430\u0437\u0430_2", "label": "\u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f / \u0415\u