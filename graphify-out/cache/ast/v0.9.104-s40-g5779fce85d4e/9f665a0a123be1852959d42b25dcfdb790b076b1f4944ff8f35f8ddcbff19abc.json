{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_economist_md", "label": "pl-economist.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-economist.md", "source_location": "L1", "frontmatter": {"name": "pl-economist", "description": "\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0433\u0435\u043d\u0442 \u0438 \u0441\u0443\u0431-\u043e\u0440\u043a\u0435\u0441\u0442\u0440\u0430\u0442\u043e\u0440 \u0431\u0438\u0437\u043d\u0435\u0441-\u0430\u043d\u0430\u043b\u0438\u0437\u0430 PL \u2013 Innovativ Digitalbau (\u0441\u043e\u043b\u043e-\u0432\u0435\u0431-\u0441\u0442\u0443\u0434\u0438\u044f Pavel Levdin, \u0440\u044b\u043d\u043a\u0438 RU \u0438 DE). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u041f\u0420\u041e\u0410\u041a\u0422\u0418\u0412\u041d\u041e \u0434\u043b\u044f \u044e\u043d\u0438\u0442-\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0438 \u0444\u0440\u0438\u043b\u0430\u043d\u0441\u0435\u0440\u0430/\u0441\u0442\u0443\u0434\u0438\u0438 \u2014 \u0447\u0430\u0441\u043e\u0432\u0430\u044f \u0441\u0442\u0430\u0432\u043a\u0430 \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u043e \u043f\u0430\u043a\u0435\u0442\u0430\u043c, \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 (utilisation), \u043c\u0430\u0440\u0436\u0430 \u043f\u0430\u043a\u0435\u0442\u043e\u0432 \u0438\u0437 pricing.json, \u0440\u0435\u0442\u0435\u0439\u043d\u0435\u0440\u044b (SEO-\u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430), \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043b\u0438\u0434\u0430 (CPL/CAC) \u043f\u043e \u043a\u0430\u043d\u0430\u043b\u0430\u043c, cash flow \u0438 \u0441\u0435\u0437\u043e\u043d\u043d\u043e\u0441\u0442\u044c, \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u00ab\u043f\u043e\u0434\u043d\u044f\u0442\u044c \u0446\u0435\u043d\u044b / \u0431\u0440\u0430\u0442\u044c \u0441\u0443\u0431\u043f\u043e\u0434\u0440\u044f\u0434 / \u043d\u0430\u043d\u044f\u0442\u044c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u0430 / \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c DE-\u0440\u044b\u043d\u043e\u043a\u00bb. \u041a\u043e\u043e\u0440\u0434\u0438\u043d\u0438\u0440\u0443\u0435\u0442 pl-market-analyst", "tools": "Read, Write, Edit, Bash, WebSearch, WebFetch, Glob, Grep", "model": "opus"}}, {"id": "$graphify-root$_claude_retired_agents_pl_economist_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-economist.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_economist_\u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442_\u043a\u0430\u043d\u043e\u043d\u044b", "label": "\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 (\u043a\u0430\u043d\u043e\u043d\u044b)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-economist.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_economist_\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435_\u0432_\u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0438", "label": "\u041f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0432 \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0438", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-economist.md", "source_location": "L17"}, {"id": "$graphify-root$_claude_retired_agents_pl_economist_\u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435_\u043c\u043e\u0434\u0435\u043b\u0438_\u0441\u0447\u0438\u0442\u0430\u0439_\u044f\u0432\u043d\u043e", "label": "\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 (\u0441\u0447\u0438\u0442\u0430\u0439 \u044f\u0432\u043d\u043e)", "file_type": "document", "node_kind": "hea