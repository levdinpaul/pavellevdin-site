{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_survey_designer_md", "label": "pl-survey-designer.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-survey-designer.md", "source_location": "L1", "frontmatter": {"name": "pl-survey-designer", "description": "\u041f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u0443\u0435\u0442 \u043e\u043f\u0440\u043e\u0441\u044b \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau \u2014 NPS/CSAT \u043f\u043e\u0441\u043b\u0435 \u0441\u0434\u0430\u0447\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 (\u0441\u0430\u0439\u0442, \u0432\u0435\u0431-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f, AI-\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f), \u0441\u0431\u043e\u0440 \u043e\u0442\u0437\u044b\u0432\u0430 (\u0432 \u0441\u0432\u044f\u0437\u043a\u0435 \u0441 \u043c\u043e\u0434\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u043e\u0442\u0437\u044b\u0432\u043e\u0432 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435), \u0446\u0435\u043d\u043e\u0432\u0430\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 Willingness-to-Pay (Van Westendorp) \u043d\u0430 \u043f\u0430\u043a\u0435\u0442\u044b, \u0434\u0440\u0430\u0439\u0432\u0435\u0440\u044b \u0432\u044b\u0431\u043e\u0440\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430 (\u0444\u0440\u0438\u043b\u0430\u043d\u0441\u0435\u0440 vs \u0441\u0442\u0443\u0434\u0438\u044f vs \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440), UX \u0431\u0440\u0438\u0444\u0430 \u0438 \u0441\u0430\u0439\u0442\u0430, \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u044f \u043d\u043e\u0432\u044b\u0445 \u0443\u0441\u043b\u0443\u0433 (\u0440\u0435\u0442\u0435\u0439\u043d\u0435\u0440\u044b, MCP, AI-\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f). \u0410\u043d\u043a\u0435\u0442\u044b RU \u0438 DE, 152-\u0424\u0417/DSGVO-\u0431\u043b\u043e\u043a. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0434\u043b\u044f \u00ab\u043e\u043f\u0440\u043e\u0441 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432\u00bb, \u00abNPS\u00bb, \u00ab\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u043e\u0442\u043e\u0432\u044b \u043f\u043b\u0430\u0442\u0438\u0442\u044c\u00bb, \u00ab\u043f\u0440\u043e\u0432\u0435\u0440", "tools": "Read, Write, Edit, WebSearch, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_survey_designer_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-survey-designer.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_survey_designer_\u0442\u0438\u043f\u044b_\u043e\u043f\u0440\u043e\u0441\u043e\u0432", "label": "\u0422\u0438\u043f\u044b \u043e\u043f\u0440\u043e\u0441\u043e\u0432", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-survey-designer.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_survey_designer_1_\u043f\u043e\u0441\u043b\u0435_\u0441\u0434\u0430\u0447\u0438_\u043f\u0440\u043e\u0435\u043a\u0442\u0430_csat_nps", "label": "1. \u041f\u043e\u0441\u043b\u0435 \u0441\u0434\u0430\u0447\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 (CSAT/NPS)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-survey-designer.md", "source_location": "L12"}, {"id": "$graphify-root$_claude_retired_agents_pl_survey_designer_2_\u0446\u0435\u043d\u043e\u0432\u0430\u044f_\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c_wtp", "label": "2. \u0426\u0435\u043d\u043e\u0432\u0430\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c / WTP", "file_ty