{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_business_plan_writer_md", "label": "pl-business-plan-writer.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-business-plan-writer.md", "source_location": "L1", "frontmatter": {"name": "pl-business-plan-writer", "description": "\u041f\u0438\u0448\u0435\u0442 \u0431\u0438\u0437\u043d\u0435\u0441-\u043f\u043b\u0430\u043d PL \u2013 Innovativ Digitalbau \u2014 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439 Businessplan/Gesch\u00e4ftsplan (\u0434\u043b\u044f Gr\u00fcndungszuschuss/Agentur f\u00fcr Arbeit, Hausbank/KfW-Mikrokredit, fachkundige Stellungnahme) \u0438\u043b\u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0441\u0442\u0443\u0434\u0438\u0438 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c (\u0432\u044b\u0445\u043e\u0434 \u043d\u0430 \u0440\u044b\u043d\u043e\u043a DE, \u0440\u0435\u0442\u0435\u0439\u043d\u0435\u0440\u044b, \u0441\u0443\u0431\u043f\u043e\u0434\u0440\u044f\u0434). \u041f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0443 (\u0440\u044b\u043d\u043e\u043a, \u044e\u043d\u0438\u0442-\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430, \u0444\u0438\u043d\u043c\u043e\u0434\u0435\u043b\u044c, \u0440\u0438\u0441\u043a\u0438) \u0432 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442 12\u201325 \u0441\u0442\u0440\u0430\u043d\u0438\u0446. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u041f\u041e\u0421\u041b\u0415 \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u0438 _business/ANALYSIS.md \u0438 \u0444\u0438\u043d\u043c\u043e\u0434\u0435\u043b\u0438.", "tools": "Read, Write, Edit, Bash, WebSearch, WebFetch, Glob, Grep", "model": "opus"}}, {"id": "$graphify-root$_claude_retired_agents_pl_business_plan_writer_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type