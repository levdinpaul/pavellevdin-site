{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_risk_analyst_md", "label": "pl-risk-analyst.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-risk-analyst.md", "source_location": "L1", "frontmatter": {"name": "pl-risk-analyst", "description": "\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u043a \u0440\u0438\u0441\u043a\u043e\u0432 PL \u2013 Innovativ Digitalbau (\u0441\u043e\u043b\u043e-\u0432\u0435\u0431-\u0441\u0442\u0443\u0434\u0438\u044f, Hannover, \u043a\u043b\u0438\u0435\u043d\u0442\u044b \u0432 \u0420\u0424 \u0438 DE/\u0415\u0421). \u0412\u044b\u044f\u0432\u043b\u044f\u0435\u0442 \u0438 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442 \u0440\u0438\u0441\u043a\u0438 \u2014 \u0440\u044b\u043d\u043e\u0447\u043d\u044b\u0435 (\u0434\u0435\u043c\u043f\u0438\u043d\u0433, \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440\u044b, AI-\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0441\u0430\u0439\u0442\u043e\u0432), \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435 (\u043d\u0435\u043e\u043f\u043b\u0430\u0442\u0430, \u043a\u0430\u0441\u0441\u043e\u0432\u044b\u0435 \u0440\u0430\u0437\u0440\u044b\u0432\u044b, \u043a\u0443\u0440\u0441 \u20bd/\u20ac, \u043f\u043b\u0430\u0442\u0435\u0436\u0438 \u0438\u0437 \u0420\u0424), \u0441\u0430\u043d\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435/\u043f\u0440\u0430\u0432\u043e\u0432\u044b\u0435 (\u0415\u0421-\u0441\u0430\u043d\u043a\u0446\u0438\u0438 \u043d\u0430 IT-\u0443\u0441\u043b\u0443\u0433\u0438 \u0432 \u0420\u0424, 152-\u0424\u0417, DSGVO, BFSG, \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0437\u0430 \u043a\u043e\u0434 \u0438 \u0445\u043e\u0441\u0442\u0438\u043d\u0433 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432), \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 (bus factor = 1, \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0437, \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442\u044b \u043f\u0440\u043e\u0434-\u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0432, \u0431\u044d\u043a\u0430\u043f\u044b, \u0441\u0435\u043a\u0440\u0435\u0442\u044b), \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c \u043e\u0442 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c (\u0431\u0438\u0440\u0436\u0438, \u042f\u043d\u0434\u0435\u043a\u0441/Google, AI-API). \u041a\u0430\u0440\u0442\u0430 \u0432\u0435\u0440\u043e\u044f\u0442", "tools": "Read, Write, WebSearch, WebFetch, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_risk_analyst_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-risk-analyst.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_risk_analyst_\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438_\u043f\u043e\u043a\u0440\u044b\u0442\u044c_\u0432\u0441\u0435", "label": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 (\u043f\u043e\u043a\u0440\u044b\u0442\u044c \u0432\u0441\u0435)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-risk-analyst.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_risk_analyst_\u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "label": "\u041c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-risk-analyst.md", "source_location": "L21"}, {"id": "$graphify-root$_claude_retired_agents_pl_risk_analyst_\u0444\u043e\u0440\u043c\u0430\u0442_\u043e\u0442\u0432\u0435\u0442\u0430", "label": "\u0424\u043e\u0440\u043c\u0430\u0442 \u043e\u0442\u0432\u0435\u0442\u0430", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-risk-analyst.md", "source_location": "L28"}, {"id": "$graphify-root$_clau