{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_lead_portals_md", "label": "pl-lead-portals.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-lead-portals.md", "source_location": "L1", "frontmatter": {"name": "pl-lead-portals", "description": "\u041c\u0435\u043d\u0435\u0434\u0436\u0435\u0440 \u0444\u0440\u0438\u043b\u0430\u043d\u0441-\u0431\u0438\u0440\u0436 \u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u043e\u043a \u0437\u0430\u043a\u0430\u0437\u043e\u0432 \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau. RU (\u0444\u0430\u0437\u0430 1) \u2014 Kwork, FL.ru, Habr Freelance, \u043f\u043b\u044e\u0441 \u0410\u0432\u0438\u0442\u043e \u0423\u0441\u043b\u0443\u0433\u0438 \u043a\u0430\u043a \u0434\u043e\u0441\u043a\u0430; DE/\u0415\u0421 (\u0444\u0430\u0437\u0430 2) \u2014 Malt, freelancermap, Upwork, \u043f\u043b\u044e\u0441 Kleinanzeigen (IT-Dienstleistungen) \u043a\u0430\u043a \u0434\u043e\u0441\u043a\u0430. \u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043f\u0440\u043e\u0444\u0438\u043b\u0438, \u043f\u0438\u0448\u0435\u0442 \u0448\u0430\u0431\u043b\u043e\u043d\u044b \u043e\u0442\u043a\u043b\u0438\u043a\u043e\u0432, \u0444\u0438\u043b\u044c\u0442\u0440\u0443\u0435\u0442 \u0437\u0430\u043a\u0430\u0437\u044b (\u043d\u0435 \u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0434\u0435\u043c\u043f\u0438\u043d\u0433), \u0441\u043b\u0435\u0434\u0438\u0442 \u0437\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u043e\u043a (\u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438, \u0437\u0430\u043f\u0440\u0435\u0442 \u0443\u0445\u043e\u0434\u0430 \u0432 \u043e\u0431\u0445\u043e\u0434, \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0438), \u0441\u0447\u0438\u0442\u0430\u0435\u0442 CPL/ROI \u043f\u043e \u043f\u043b\u043e\u0449\u0430\u0434\u043a\u0435. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0434\u043b\u044f \u0437\u0430\u0434\u0430\u0447 \u043f\u0440\u043e \u0431\u0438\u0440\u0436\u0438, \u043e\u0442\u043a\u043b\u0438\u043a\u0438, \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0444\u0440\u0438\u043b\u0430\u043d\u0441\u0435\u0440\u0430, \u00ab\u043e\u0442\u043a\u0443\u0434\u0430 \u0431\u0440\u0430\u0442\u044c \u0437\u0430\u043a\u0430\u0437", "tools": "Read, Write, Edit, WebSearch, WebFetch, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_lead_portals_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-lead-portals.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_lead_portals_\u043f\u043b\u043e\u0449\u0430\u0434\u043a\u0438", "label": "\u041f\u043b\u043e\u0449\u0430\u0434\u043a\u0438", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-lead-portals.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_lead_portals_\u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b", "label": "\u041f\u0440\u0438\u043d\u0446\u0438\u043f\u044b", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-lead-portals.md", "source_location": "L23"}, {"id": "$graphify-root$_claude_retired_agents_pl_lead_portals_\u0447\u0442\u043e_\u0442\u044b_\u0434\u0435\u043b\u0430\u0435\u0448\u044c", "label": "\u0427\u0442\u043e \u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-lead-portals.md", "source_location": "L31"}, {"id": "$graphify-root$_claude_retired_agents_pl_lead_portals_\u0441\u0432\u044f\u0437\u043a\u0438", "label": "\u0421\u0432\u044f\u0437\u043a\u0438", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-lead-portals.md", "source_location": "L39"}, {"id": "$graphify-root$_claude_retired_agents_pl_lead_portals_\u0436\u04