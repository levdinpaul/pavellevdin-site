{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_copywriter_de_md", "label": "pl-copywriter-de.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-copywriter-de.md", "source_location": "L1", "frontmatter": {"name": "pl-copywriter-de", "description": "\u041d\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u044f\u0437\u044b\u0447\u043d\u044b\u0439 \u043a\u043e\u043f\u0438\u0440\u0430\u0439\u0442\u0435\u0440 \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau (\u0432\u0435\u0431-\u0441\u0442\u0443\u0434\u0438\u044f Pavel Levdin, Hannover) \u2014 \u0440\u044b\u043d\u043e\u043a DE/\u0415\u0421, \u0444\u0430\u0437\u0430 2. \u041f\u0438\u0448\u0435\u0442 \u043d\u0430 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c \u0442\u0435\u043a\u0441\u0442\u044b \u0441\u0430\u0439\u0442\u0430 (de-\u043b\u043e\u043a\u0430\u043b\u044c, \u043b\u0435\u043d\u0434\u0438\u043d\u0433\u0438 \u0443\u0441\u043b\u0443\u0433), \u043f\u0440\u043e\u0444\u0438\u043b\u0438 \u0438 \u043e\u0442\u043a\u043b\u0438\u043a\u0438 \u0434\u043b\u044f Malt/freelancermap, Google-Ads-\u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u044f, \u043f\u043e\u0441\u0442\u044b, \u043f\u0438\u0441\u044c\u043c\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u043c \u0438 \u043f\u0430\u0440\u0442\u043d\u0451\u0440\u0430\u043c \u2014 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043d\u044b\u0439 \u0442\u043e\u043d, \u0431\u0435\u0437 \u0445\u0430\u0439\u043f\u0430, SEO, \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0438 (UWG). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0434\u043b\u044f \u043b\u044e\u0431\u044b\u0445 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0445 \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433\u043e\u0432\u044b\u0445/\u0441\u0430\u0439\u0442\u043e\u0432\u044b\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0430.", "tools": "Read, Write, Edit, WebSearch, WebFetch, Glob, Grep", "model": "opus"}}, {"id": "$graphify-root$_claude_retired_agents_pl_copywriter_de_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-copywriter-de.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_copywriter_de_\u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442", "label": "\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-copywriter-de.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_copywriter_de_\u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b", "label": "\u041f\u0440\u0438\u043d\u0446\u0438\u043f\u044b", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-copywriter-de.md", "source_location": "L16"}, {"id": "$graphify-root$_claude_retired_agents_pl_copywriter_de_\u0447\u0442\u043e_\u043f\u0438\u0448\u0435\u0448\u044c", "label": "\u0427\u0442\u043e \u043f\u0438\u0448\u0435\u0448\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-copywriter-de.md", "source_location": "L23"}, {"id": "$graphify-root$_claude_retired_agents_pl_copywriter_de_\u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "label": "\u041c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u044f", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-copywriter-de.md", "source_location": "L30"}, {"id": "$graphify-root$_claude_retired_agents_pl_copywriter_de_\u0444\u043e\u0440\u043c\u0430\u0442_\u043e\u0442\u0432\u0435\u0442\u0430", "label": "\u0424\u043e\u0440\u043c\u0430\u0442 \u043e\u0442\u0432\u0435\u0442\u0430", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents