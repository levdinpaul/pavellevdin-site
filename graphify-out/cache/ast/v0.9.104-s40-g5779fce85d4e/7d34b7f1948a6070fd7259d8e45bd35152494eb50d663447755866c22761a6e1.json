{"nodes": [{"id": "$graphify-root$_claude_retired_agents_pl_community_outreach_md", "label": "pl-community-outreach.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/_retired-agents/pl-community-outreach.md", "source_location": "L1", "frontmatter": {"name": "pl-community-outreach", "description": "\u041c\u0435\u043d\u0435\u0434\u0436\u0435\u0440 community-\u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433\u0430 \u0434\u043b\u044f PL \u2013 Innovativ Digitalbau \u2014 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0442\u0430\u043c, \u0433\u0434\u0435 \u0443\u0436\u0435 \u0441\u0438\u0434\u044f\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u044b \u0438 \u043f\u0430\u0440\u0442\u043d\u0451\u0440\u044b. RU \u2014 Telegram-\u0447\u0430\u0442\u044b \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0435\u0439 \u0438 \u043c\u0430\u0440\u043a\u0435\u0442\u043e\u043b\u043e\u0433\u043e\u0432, vc.ru, Habr (\u0441\u0442\u0430\u0442\u044c\u0438/\u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438), \u043f\u0440\u043e\u0444\u0438\u043b\u044c\u043d\u044b\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 (Next.js, AI-\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f, MCP). DE \u2014 LinkedIn, XING-Gruppen, Meetups/Netzwerke Hannover (IT, Gr\u00fcnder, Handwerk-Digitalisierung), \u0440\u0443\u0441\u0441\u043a\u043e\u044f\u0437\u044b\u0447\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0438 \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u0438. \u0412\u0435\u0434\u0451\u0442 \u0440\u0435\u0435\u0441\u0442\u0440 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432 \u0441 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438, \u043f\u0438\u0448\u0435\u0442 value-first \u043f\u043e\u0441\u0442\u044b, \u043e\u0442\u0432\u0435\u0442\u044b \u043d\u0430 \u00ab\u0438\u0449\u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430\u00bb, \u043a\u0430\u0434\u0435\u043d\u0441 \u0431\u0435\u0437 \u0441\u043f\u0430\u043c-\u0431\u0430\u043d\u0430. \u0418\u0441\u043f\u043e\u043b", "tools": "Read, Write, Edit, WebSearch, WebFetch, Glob, Grep", "model": "sonnet"}}, {"id": "$graphify-root$_claude_retired_agents_pl_community_outreach_\u0440\u043e\u043b\u044c", "label": "\u0420\u043e\u043b\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-community-outreach.md", "source_location": "L8"}, {"id": "$graphify-root$_claude_retired_agents_pl_community_outreach_\u043a\u0430\u043d\u0430\u043b\u044b", "label": "\u041a\u0430\u043d\u0430\u043b\u044b", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-community-outreach.md", "source_location": "L11"}, {"id": "$graphify-root$_claude_retired_agents_pl_community_outreach_\u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b_\u0438\u043d\u0430\u0447\u0435_\u0431\u0430\u043d_\u0438_\u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439_\u043c\u0438\u043d\u0443\u0441", "label": "\u041f\u0440\u0438\u043d\u0446\u0438\u043f\u044b (\u0438\u043d\u0430\u0447\u0435 \u0431\u0430\u043d \u0438 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043c\u0438\u043d\u0443\u0441)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-community-outreach.md", "source_location": "L21"}, {"id": "$graphify-root$_claude_retired_agents_pl_community_outreach_\u0447\u0442\u043e_\u0442\u044b_\u0434\u0435\u043b\u0430\u0435\u0448\u044c", "label": "\u0427\u0442\u043e \u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c", "file_type": "document", "node_kind": "heading", "source_file": ".claude/_retired-agents/pl-community-outreach.md", "source_location": "L28"}, {"id": "$graphify-root$_claude_retired_agents_pl_community_outreach_\u0441\u0432\u044f\u0437\u043a\u