# Бэкенд сайта (scripts/server.js): лиды, отзывы, экспресс-аудит, статика.
# На проде — /srv/sites/pavellevdin.ru/projects/app/.env (НЕ в git). Фронтенд читает только env/.env (VITE_*).

NODE_ENV=production
ADMIN_PORT=3001
JWT_SECRET=

# Telegram-уведомления (лиды, отзывы, аудит)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# С russh api.telegram.org недоступен → запросы идут через ретранслятор на немецком VPS
# (схема — README, «Telegram через ретранслятор»). Пусто → https://api.telegram.org напрямую.
TELEGRAM_API_BASE=http://tg-relay:18081
# Ключ ретранслятора — уходит заголовком X-Relay-Key. Пусто → заголовок не отправляется.
TELEGRAM_RELAY_KEY=

# Почта (scripts/lib/mailer.js)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_STARTTLS=
SMTP_TLS_STRICT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_MAIL_RU=
LEAD_MAIL_EU=
DE_MAIL_READY=false

# Экспресс-аудит (/api/audit): аварийно выключить — false; PSI_API_KEY — PageSpeed Insights (необязательно)
AUDIT_ENABLED=true
PSI_API_KEY=
